# Server
PORT=3000
NODE_ENV=development

# JWT – generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Apple Sign In
# Your Apple Services ID (used as OAuth2 client_id for web, also as OIDC audience)
APPLE_CLIENT_ID=com.yourcompany.spotify-kids
# Team ID from Apple Developer portal
APPLE_TEAM_ID=XXXXXXXXXX
# Key ID from the .p8 private key you downloaded
APPLE_KEY_ID=XXXXXXXXXX
# Contents of the .p8 file (replace newlines with \n)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Parent Apple user IDs (comma-separated)
# Find these in the Apple identity token 'sub' field after first sign-in.
# Set these AFTER the two parent accounts have signed in once (you'll see them in logs).
PARENT_APPLE_IDS=000000.abcdef1234567890abcdef1234567890.1234,000000.fedcba0987654321fedcba0987654321.4321

# Spotify App Credentials
# Create at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must match exactly what you set in Spotify Dashboard
SPOTIFY_REDIRECT_URI=spotify-kids://spotify-callback

# Database path
DB_PATH=./data/spotify-kids.db
