# Server
PORT=3000
NODE_ENV=development

# JWT – generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Static users – format: username:password:role  (role = parent or child)
# Add as many users as you need, comma-separated.
# Passwords are stored in plain text in this file so keep it local and gitignored.
STATIC_USERS=parent:parentpass:parent,kid:kidpass:child

# Spotify App Credentials
# Create at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must match exactly what you set in Spotify Dashboard
SPOTIFY_REDIRECT_URI=spotify-kids://spotify-callback

# Database path
DB_PATH=./data/spotify-kids.db
